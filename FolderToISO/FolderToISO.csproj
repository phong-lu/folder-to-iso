<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DesktopPlatform Condition="'$(DesktopPlatform)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">Windows</DesktopPlatform>
    <DesktopPlatform Condition="'$(DesktopPlatform)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">MacCatalyst</DesktopPlatform>
    <DesktopPlatform Condition="'$(DesktopPlatform)' == ''">Linux</DesktopPlatform>
    <RootNamespace>FolderToISO</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DesktopPlatform)' != 'Linux'">
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ApplicationTitle>FolderToISO</ApplicationTitle>
    <ApplicationId>io.github.foldertoiso.app</ApplicationId>
    <ApplicationDisplayVersion Condition="'$(Version)' != ''">$(Version)</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="'$(ApplicationDisplayVersion)' == ''">1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DesktopPlatform)' == 'Windows'">
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>FolderToISO.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DesktopPlatform)' == 'MacCatalyst'">
    <TargetFramework>net10.0-maccatalyst</TargetFramework>
    <!-- Catalyst 17 corresponds to macOS 14. -->
    <SupportedOSPlatformVersion>17.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>maccatalyst-arm64</RuntimeIdentifier>
    <EnableAppSandbox>false</EnableAppSandbox>
    <CodesignEntitlements>Platforms/MacCatalyst/Entitlements.plist</CodesignEntitlements>
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>
  <PropertyGroup Condition="'$(DesktopPlatform)' == 'Linux'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <ItemGroup Condition="'$(DesktopPlatform)' != 'Linux'">
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <MauiImage Include="Resources/Images/foldertoiso.png" />
    <MauiIcon Include="Resources/AppIcon/appicon.png" />
    <Compile Remove="Linux/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesktopPlatform)' == 'Windows'">
    <Content Include="FolderToISO.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesktopPlatform)' == 'Linux'">
    <Compile Remove="App.xaml.cs;MainPage.xaml.cs;MauiProgram.cs;Platforms/**/*.cs;DesktopFiles.cs" />
  </ItemGroup>
  <Target Name="ValidateDesktopPlatform" BeforeTargets="PrepareForBuild"
          Condition="'$(DesktopPlatform)' != 'Windows' and '$(DesktopPlatform)' != 'Linux' and '$(DesktopPlatform)' != 'MacCatalyst'">
    <Error Text="DesktopPlatform must be Windows, MacCatalyst or Linux." />
  </Target>
  <Target Name="PublishApplicationResources" BeforeTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="$(GenerateProjectPriFile)" Condition="'$(DesktopPlatform)' == 'Windows'">
    <Error Condition="!Exists('$(ProjectPriFullPath)')" Text="The application resource index is missing: $(ProjectPriFullPath)" />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
