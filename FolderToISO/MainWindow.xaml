<Window x:Class="FolderToISO.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="FolderToISO">
            <TitleBar.IconSource>
                <BitmapIconSource UriSource="ms-appx:///FolderToISO.png" ShowAsMonochrome="False" />
            </TitleBar.IconSource>
        </TitleBar>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LayoutPanel" Padding="32" Spacing="24" HorizontalAlignment="Stretch" Loaded="LayoutPanel_Loaded">
                <Grid ColumnSpacing="18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="ms-appx:///FolderToISO.png" Width="64" Height="64" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.Name="FolderToISO icon" />
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="FolderToISO" Style="{StaticResource TitleTextBlockStyle}" />
                        <TextBlock Text="Burn a folder contents to ISO file" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                    <StackPanel Spacing="20">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="SourceBox" Header="Source folder" PlaceholderText="Choose a folder" MinHeight="40" LostFocus="SourceBox_LostFocus" />
                            <Button x:Name="SourceButton" Grid.Column="1" Content="Browse&#x2026;" MinWidth="108" Height="40" VerticalAlignment="Bottom" Click="BrowseSource_Click" />
                            <TextBlock x:Name="InvalidSourceText" Grid.Row="2" Text="Invalid folder" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" Margin="0,6,0,0" Visibility="Collapsed" />
                            <TextBlock Grid.Row="1" Text="Your folder's contents become the root of the image." Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextControlHeaderForeground}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </Grid>
                        <Grid x:Name="DestinationSummary" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Spacing="6" VerticalAlignment="Center">
                                <TextBlock x:Name="OutputSummary" TextWrapping="Wrap" />
                                <Grid x:Name="SummaryFat32Warning" Visibility="Collapsed" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" Data="M 6,0 L 14,0 L 20,6 L 20,14 L 14,20 L 6,20 L 0,14 L 0,6 Z M 6,6 L 14,14 M 14,6 L 6,14" Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="1.8" />
                                    <TextBlock Grid.Column="1" Text="Save the ISO to NTFS or exFAT. FAT32 cannot store an ISO larger than 4 GB." Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </Grid>
                                <TextBlock x:Name="LabelSummary" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button x:Name="ChangeDestinationButton" Grid.Column="1" Content="Change output" Visibility="Collapsed" MinHeight="40" VerticalAlignment="Center" Click="ChangeDestination_Click" />
                        </Grid>
                        <Grid x:Name="OutputEditor" ColumnSpacing="12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBox x:Name="OutputBox" Header="ISO file" PlaceholderText="Choose where to save the .iso file" MinHeight="40" />
                            <Button x:Name="OutputButton" Grid.Column="1" Content="Save as&#x2026;" MinWidth="108" Height="40" VerticalAlignment="Bottom" Click="BrowseOutput_Click" />
                            <Grid x:Name="EditorFat32Warning" Grid.Row="1" Grid.ColumnSpan="2" Visibility="Collapsed" ColumnSpacing="8" Margin="0,6,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,0,0" Data="M 6,0 L 14,0 L 20,6 L 20,14 L 14,20 L 6,20 L 0,14 L 0,6 Z M 6,6 L 14,14 M 14,6 L 6,14" Stroke="{ThemeResource SystemFillColorCriticalBrush}" StrokeThickness="1.8" />
                                <TextBlock Grid.Column="1" Text="Save the ISO to NTFS or exFAT. FAT32 cannot store an ISO larger than 4 GB." Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                        <StackPanel x:Name="LabelEditor" Spacing="6" Visibility="Collapsed">
                            <TextBox x:Name="LabelBox" Header="Volume label" MaxLength="32" MinHeight="40" />
                            <TextBlock x:Name="LabelDescription" Text="The output ISO's volume label" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextControlHeaderForeground}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="16">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <Button x:Name="CreateButton" Content="Create ISO" IsEnabled="False" MinWidth="132" Height="40" Style="{StaticResource AccentButtonStyle}" Click="Create_Click" />
                        <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" Height="40" IsEnabled="False" Click="Cancel_Click" />
                    </StackPanel>
                    <Grid Grid.Column="1" ColumnSpacing="12" MinHeight="40" HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="StatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Right" VerticalAlignment="Center" />
                        <Button x:Name="OpenFolderButton" Grid.Column="1" Visibility="Collapsed" Width="48" Height="40" Padding="10,0" HorizontalContentAlignment="Center" ToolTipService.ToolTip="Open the contained folder" AutomationProperties.Name="Open the contained folder" Click="OpenFolder_Click">
                            <Viewbox Width="20" Height="20"><Path Width="24" Height="24" Data="M 2,4 L 9,4 L 12,7 L 22,7 L 22,20 L 2,20 Z M 2,9 L 22,9" Stroke="{ThemeResource TextFillColorPrimaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" /></Viewbox>
                        </Button>
                    </Grid>
                    </Grid>
                    <ProgressBar x:Name="ProgressBar" Minimum="0" Maximum="100" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>








