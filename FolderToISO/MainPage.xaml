<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FolderToISO.MainPage" Title="FolderToISO">
  <ScrollView>
    <VerticalStackLayout Padding="32" Spacing="20">
      <HorizontalStackLayout Spacing="16">
        <Image Source="foldertoiso.png" WidthRequest="64" HeightRequest="64" SemanticProperties.Description="FolderToISO icon" />
        <VerticalStackLayout VerticalOptions="Center" Spacing="4">
          <Label Text="FolderToISO" FontSize="28" FontAttributes="Bold" />
          <Label Text="Turn a folder into a disc image" />
        </VerticalStackLayout>
      </HorizontalStackLayout>
      <VerticalStackLayout x:Name="Editors" Spacing="12">
        <Label Text="Source folder" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <Entry x:Name="SourceBox" AutomationId="SourceBox" Placeholder="Choose a folder" TextChanged="SourceChanged" />
          <Button Grid.Column="1" Text="Browse…" Clicked="BrowseSource" />
        </Grid>
        <Label x:Name="InvalidSource" Text="Select an existing source folder." TextColor="{AppThemeBinding Light=#B42318, Dark=#FFB4AB}" IsVisible="False" />
        <Label Text="Your folder's contents become the root of the image." FontSize="12" />
        <Label Text="ISO file" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <Entry x:Name="OutputBox" AutomationId="OutputBox" Placeholder="Choose where to save the .iso file" TextChanged="DestinationChanged" />
          <Button x:Name="OutputButton" Grid.Column="1" Text="Save as…" Clicked="BrowseOutput" />
        </Grid>
        <Label x:Name="Fat32Warning" Text="Save large images to a filesystem supporting files over 4 GiB, such as exFAT. FAT32 has a 4 GiB file limit." FontSize="12" IsVisible="False" />
        <Label Text="Volume label" />
        <Entry x:Name="LabelBox" AutomationId="LabelBox" MaxLength="32" Text="FolderToISO" />
      </VerticalStackLayout>
      <Label Text="UDF supports individual files larger than 4 GiB. Keep the source folder unchanged until creation completes." FontSize="12" />
      <HorizontalStackLayout Spacing="12">
        <Button x:Name="CreateButton" AutomationId="CreateButton" Text="Create ISO" IsEnabled="False" Clicked="CreateIso" />
        <Button x:Name="CancelButton" Text="Cancel" IsEnabled="False" Clicked="CancelIso" />
        <Button x:Name="OpenButton" Text="Open folder" IsVisible="False" Clicked="OpenFolder" />
      </HorizontalStackLayout>
      <ActivityIndicator x:Name="Activity" IsVisible="False" />
      <ProgressBar x:Name="Progress" IsVisible="False" />
      <Label x:Name="Status" AutomationId="Status" Text="Ready" />
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
